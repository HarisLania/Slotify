# ---------------------------------------------------------------------------
# BookEase environment variables.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Django secret key — generate a fresh one for every environment.
SECRET_KEY=change-me-to-a-long-random-string

# Debug mode. Keep False in production.
DEBUG=True

# Production hardening flag. Set True in real deployments to enable
# HTTPS redirects, secure cookies, HSTS, etc. Independent of DEBUG.
PRODUCTION=False

# Comma-separated list of allowed hosts, e.g. api.bookease.com,localhost
ALLOWED_HOSTS=*

# Database connection.
# Leave unset to use the local SQLite file (good for dev/testing), or set a
# Postgres URL for production, e.g.:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/bookease
# DATABASE_URL=postgres://bookease:bookease@localhost:5432/bookease

# JWT token lifetimes.
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# CORS — allow the customer-facing frontend to call the API.
# For production, set CORS_ALLOW_ALL_ORIGINS=False and list explicit origins.
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://app.bookease.com,https://book.bookease.com
